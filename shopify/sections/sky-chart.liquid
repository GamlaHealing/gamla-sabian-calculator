{%- comment -%} Gamla Healing sky in motion. Generated from sky/markup.html by sky/build.py. Edit the source, not this file. {%- endcomment -%}
<link rel="stylesheet" href="{{ section.settings.cdn_base }}/sky.css">

<div class="gs" data-default="{{ section.settings.default_mode }}">
<section class="gs-band gs-sky" aria-labelledby="gs-title">
 <div class="gs-inner">
  <div class="gs-top"><div>
  <h1 id="gs-title">The sky right now</h1>
  <p class="gs-when" id="gs-when">Loading the ephemeris…</p>
  </div><button type="button" class="gs-mode" id="gs-mode">Night sky</button></div>
  {%- if section.settings.intro != blank -%}<p class="gs-intro">{{ section.settings.intro }}</p>{%- endif -%}
  <div class="gs-grid">
   <div class="gs-wheelbox">
    <svg id="gs-wheel" viewBox="0 0 600 600" role="img" aria-label="Chart wheel of the sky at the chosen moment"></svg>
    <p class="gs-loading" id="gs-loading" hidden></p>
   </div>
   <div class="gs-ctl">
    <div class="gs-card">
     <h2>Move through time</h2>
     <div class="gs-row" style="margin-bottom:12px">
      <button type="button" class="gs-primary" id="gs-play" aria-pressed="false">Play</button>
      <select id="gs-speed" aria-label="Playback speed">
       <option value="0.0417">1 hour per second</option>
       <option value="1" selected>1 day per second</option>
       <option value="7">1 week per second</option>
       <option value="30.44">1 month per second</option>
       <option value="365.25">1 year per second</option>
       <option value="3652.5">10 years per second</option>
      </select>
      <button type="button" id="gs-dir" aria-label="Play direction: forward">Forward</button>
      <button type="button" id="gs-now">Now</button>
     </div>
     <div class="gs-step" id="gs-steps"></div>
    </div>
    <div class="gs-card">
     <h2>Go to a date</h2>
     <div class="gs-date">
      <input id="gs-d" type="number" min="1" max="31" aria-label="Day" inputmode="numeric">
      <select id="gs-m" aria-label="Month"></select>
      <input id="gs-y" type="number" min="1" max="4000" aria-label="Year" inputmode="numeric">
      <select id="gs-era" aria-label="Era"><option>AD</option><option>BC</option></select>
     </div>
     <div class="gs-row" style="margin-top:8px"><input id="gs-time" type="time" step="60" aria-label="Local time"><span class="gs-meta" id="gs-zone" style="margin:0"></span></div>
     <input class="gs-range" id="gs-yr" type="range" min="-3999" max="2999" step="1" aria-label="Year slider">
     <div class="gs-ticks"><span>4000 BC</span><span>2000 BC</span><span>1 AD</span><span>2999 AD</span></div>
    </div>
    <div class="gs-card">
     <h2>Seen from</h2>
     <div class="gs-place">
      <input id="gs-place" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="gs-sug" aria-label="Place for houses and local time" placeholder="Search a city">
      <ul class="gs-sug" id="gs-sug" role="listbox" hidden></ul>
     </div>
     <p class="gs-meta" id="gs-placemeta"></p>
    </div>
    <div class="gs-card gs-moon" id="gs-moon"></div>
    <p class="gs-warn" id="gs-warn" hidden></p>
   </div>
  </div>
 </div>
</section>

<section class="gs-band gs-ledger" aria-labelledby="gs-lh">
 <div class="gs-inner">
  <h2 id="gs-lh">{{ section.settings.ledger_heading | escape }}</h2>
  {%- if section.settings.ledger_intro != blank -%}<p class="gs-sub">{{ section.settings.ledger_intro | escape }}</p>{%- endif -%}
  <div style="overflow-x:auto"><table class="gs-stack" id="gs-ledger"><thead><tr><th>Point</th><th>Position</th><th>House</th><th>Sabian symbol</th><th>Read more</th></tr></thead><tbody></tbody></table></div>
 </div>
</section>

<section class="gs-band gs-notes" aria-labelledby="gs-nh">
 <div class="gs-inner">
  <h2 id="gs-nh">{{ section.settings.notes_heading | escape }}</h2>
  <div class="gs-cols">
  {%- for block in section.blocks -%}
   <div {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
  {%- endfor -%}
  </div>
  <p class="gs-credit">Symbol wording: Dane Rudhyar, An Astrological Mandala (1973), adapted where the original wording is dated. Interpretations and articles: Sylvain Vanhuysse. Positions: Swiss Ephemeris (Astrodienst). Place data: <a href="https://www.geonames.org/" target="_blank" rel="noopener">GeoNames</a>, CC BY 4.0. {%- if section.settings.source_url != blank -%}<a href="{{ section.settings.source_url }}" target="_blank" rel="noopener">Source code</a> licensed AGPL-3.0.{%- endif -%}</p>
 </div>
</section>
</div>
<script>new MutationObserver(function(){document.querySelectorAll('.gs .gs-stack td:not([data-l])').forEach(function(c){var i=0,p=c;while(p=p.previousElementSibling)i+=p.colSpan;var h=c.closest('table').rows[0].cells[i];c.dataset.l=h?h.textContent:''})}).observe(document.getElementById('gs-ledger'),{childList:true,subtree:true});</script>

{%- if section.settings.cdn_base != blank -%}
<script type="module" src="{{ section.settings.cdn_base }}/sky.js"></script>
{%- else -%}
<p style="text-align:center;color:#B3261E">Sky chart: set the "Sky chart files URL" in the theme editor.</p>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "The Sky in Motion",
  "url": "{{ shop.url }}{{ request.path }}",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Any",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
  "description": "Live astrology chart of the sky with every planet's sign, house and Sabian degree, for any moment from 4000 BC to 2999 AD, calculated with the Swiss Ephemeris.",
  "publisher": { "@type": "Organization", "name": "Gamla Healing", "url": "{{ shop.url }}" }
}
</script>

{% schema %}
{
  "name": "Sky in motion",
  "tag": "section",
  "class": "section-sky-chart",
  "settings": [
    {
      "type": "text",
      "id": "cdn_base",
      "label": "Sky chart files URL",
      "info": "jsDelivr URL of the sky folder, e.g. https://cdn.jsdelivr.net/gh/GamlaHealing/gamla-sabian-calculator@v1.3.0/sky (no trailing slash)"
    },
    {
      "type": "url",
      "id": "source_url",
      "label": "Source code link (AGPL)"
    },
    {
      "type": "select",
      "id": "default_mode",
      "label": "Version shown first",
      "default": "day",
      "options": [
        {
          "value": "day",
          "label": "Day (light)"
        },
        {
          "value": "night",
          "label": "Night (dark)"
        }
      ],
      "info": "Visitors can switch with the Day sky / Night sky button; their choice is remembered on their device."
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "Watch the planets move in real time, or travel to any moment from 4000 BC to 2999 AD. Every placement links to its Sabian symbol and to the full article on it."
    },
    {
      "type": "text",
      "id": "ledger_heading",
      "label": "Placements heading",
      "default": "Every placement at this moment"
    },
    {
      "type": "textarea",
      "id": "ledger_intro",
      "label": "Placements introduction",
      "default": "Each planet with its exact position, its house for the place you chose, and its Sabian degree. Follow the links to read the symbol and the placement in depth."
    },
    {
      "type": "text",
      "id": "notes_heading",
      "label": "Notes heading",
      "default": "How this sky is calculated"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Sky in motion",
      "blocks": [
        {
          "type": "note",
          "settings": {
            "title": "Ephemeris",
            "text": "Positions come from the Swiss Ephemeris by Astrodienst, built on NASA JPL's DE431 for 1800 to 2400 and DE441 for every other century. Each 600-year block loads only when you travel into it."
          }
        },
        {
          "type": "note",
          "settings": {
            "title": "Conventions",
            "text": "Tropical zodiac, Placidus houses (Whole Sign near the poles, where Placidus does not exist), mean Node. A planet at 20°02' sits in the 21st Sabian degree, following Rudhyar and Wheeler."
          }
        },
        {
          "type": "note",
          "settings": {
            "title": "Calendar",
            "text": "Dates before 15 October 1582 use the Julian calendar, as historians write them. There is no year 0: 1 BC is followed by 1 AD."
          }
        },
        {
          "type": "note",
          "settings": {
            "title": "Clock time",
            "text": "From 1850 the time shown is the legal time of the place's time zone. Before 1850 it is the local mean time of the place, the time a sundial-based clock would have kept there."
          }
        },
        {
          "type": "note",
          "settings": {
            "title": "Ancient dates",
            "text": "The planets stay reliable across the whole range. What becomes uncertain is the clock: the slowing of the Earth's rotation can only be estimated for the deep past, so for a precise hour long ago the Moon may fall in a neighbouring Sabian degree and the Ascendant and houses can shift by several degrees or more."
          }
        },
        {
          "type": "note",
          "settings": {
            "title": "Signs and constellations",
            "text": "The tropical zodiac is measured from the spring equinox of each year. Because of precession, in 4000 BC the signs lay over different constellations than they do today."
          }
        }
      ]
    }
  ]
}
{% endschema %}
